# Google OAuth Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# Optional: Use minimal Google scopes (YouTube + OpenID only; no profile/email)
# Set to true to disable userinfo.profile and userinfo.email scopes
# DISABLE_GOOGLE_SCOPES=true
# Or override scopes entirely (space-separated):
# GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

# Server Configuration
NODE_ENV=production
PORT=3000

# Optional: Custom paths (defaults to ./uploads and ./data)
# UPLOADS_DIR=/var/www/uploads
# DATA_DIR=/var/www/data

# Python bot manifest queue (optional)
# Preferred: configure a Dropbox bot folder from the dashboard (Upload Videos → pick folder with manifests/, videos/, thumbnails/). The worker then reads manifests from Dropbox using your session; no PYTHON_QUEUE_ROOT required.
# Legacy: worker.ts can also read manifests from a local filesystem directory (leave PYTHON_QUEUE_ROOT unset when using Dropbox-only queue).
# Directory layout: $PYTHON_QUEUE_ROOT/manifests/*.json, processed/, failed/
# PYTHON_QUEUE_ROOT=/mnt/shared/queue
# Session id from data/sessions.json after logging in via the web UI (cookie value), or set sessionId per manifest
# PYTHON_SESSION_ID=your_session_id_here
# Max manifest JSON files to process per worker tick (default 1; bulk queue runs after)
# PYTHON_QUEUE_MAX_PER_TICK=1
# If true, skip upload when title matches data/uploaded-videos.json (case-insensitive)
# PYTHON_SKIP_DUPLICATE_TITLES=false

# Worker pause (optional): Dashboard "Stop" in Queue mode creates data/.worker-paused; worker idles until "Start".
# APIs: GET /api/queue-worker/status, POST /api/queue-worker/start, POST /api/queue-worker/stop

# Optional: BYOK AI snippet assist (title/description suggestions from Dashboard).
# Keys can also be saved per-session in the UI (stored in data/sessions.json like other tokens).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Note: In production, make sure:
# 1. GOOGLE_REDIRECT_URI matches your actual domain with HTTPS
# 2. NODE_ENV is set to "production" for secure cookies
# 3. All sensitive values are kept secure and not committed to git
